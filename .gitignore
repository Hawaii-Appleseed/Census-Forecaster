# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.pytest_cache/
.coverage
htmlcov/
build/
dist/
!dashboard/dist/
.tox/

# Virtual envs
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store

# Caches written by the package at runtime
data/cache/
*.cache.json

# tax_modeler heavy data — fetched on demand via:
#   uv run python -m tax_modeler.scripts.fetch_dotax_soi
#   uv run python -m tax_modeler.scripts.fetch_irs_soi
data/tax_modeler/raw/
data/tax_modeler/external/
data/tax_modeler/processed/
!data/tax_modeler/raw/.gitkeep
!data/tax_modeler/external/.gitkeep
!data/tax_modeler/processed/.gitkeep

# Raw PUMS microdata (downloaded on demand from
# https://www2.census.gov/programs-surveys/acs/data/pums/2022/5-Year/)
# Applies to every vintage dir (pums/, pums_2024_1yr/, …). The zips just
# re-contain the CSVs + README, and PUMSDataLoader prefers parquet for all
# vintages, so only the parquet is worth versioning.
packages/data/raw/**/*.csv
packages/data/raw/**/*.zip
packages/data/raw/**/*.pdf
packages/data/raw/pums/*.parquet

# Versioned forecast artifacts (caches + calibrated bases; rebuilt locally)
data/artifacts/

# Manifested run outputs (regenerable; manifest.json records provenance)
runs/

# Dashboard machine-readable index — regenerable intermediate whose payload
# is already embedded in dashboard.html; would churn on every run.
dashboard/dist/index.json

# Run outputs written by forecast_rxkids_2028.py — regenerable, not inputs
reports/**/spm_units.parquet

# Editor/backup leftovers and stray run logs
*.bak
*.log

# API keys — never commit (keys live in ~/.eia_api_key, ~/.census_api_key)
*_api_key
.*_api_key

# credentials — never commit these (added 2026-10-23)
.env
.env.*
!.env.example
*.pem
*.key
token.json
credentials.json
client_secret*.json
service-account*.json
*_api_key
